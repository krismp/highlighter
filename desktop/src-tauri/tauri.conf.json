{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Highlighter",
  "mainBinaryName": "Highlighter",
  "version": "1.0.0",
  "identifier": "com.github.krismp.highlighter",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "shortDescription": "Cut every play out of a match",
    "longDescription": "Paste a YouTube URL, mark the start of each play, review each clip, and get one MP4 per play.",
    "copyright": "Highlighter contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/highlighter-server",
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/deno"
    ],
    "resources": {
      "resources/cacert.pem": "cacert.pem",
      "../../packaging/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
